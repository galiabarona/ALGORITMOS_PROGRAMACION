	//Ejercicio 3.8 
	
	Escribir ""
	Escribir "Actividad 3.8 - Si el valor de A es 4, el valor de B es 5 y el valor de C es 1, evaluar las siguientes expresiones"
	
	A = 4
	B = 5
	C = 1
	
	Escribir "Valores: A = 4, B = 5 y C = 1"
	Escribir ""
	
	Escribir "a) B * A - B ^ 2 / 4 * C"
	Escribir "Resultado: ", B * A - B ^ 2 / 4 * C
	Escribir ""
	Escribir "b) (A * B) / 3 ^ 2"
	Escribir "Resultado: ", (A * B) / 3 ^ 2
	Escribir ""
	Escribir "c) (((B + C) / 2 * A + 10) * 3 * B) - 6"
	Escribir "Resultado: ", (((B + C) / 2 * A + 10) * 3 * B) - 6
	
