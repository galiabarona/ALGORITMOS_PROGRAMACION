// Descripción: Convertir una temperatura en grados Celsius a grados Kelvin y Fahrenheit
Algoritmo Ejercicio_02
	Definir celsius, kelvin, fahrenheit Como Real
	Escribir 'Ingresa la temperatura en grados Celsius:'
	Leer celsius
	kelvin <- celsius+273.15
	fahrenheit <- (celsius*9/5)+32
	Escribir 'La temperatura en grados Kelvin es: ', kelvin
	Escribir 'La temperatura en grados Fahrenheit es: ', fahrenheit
FinAlgoritmo
