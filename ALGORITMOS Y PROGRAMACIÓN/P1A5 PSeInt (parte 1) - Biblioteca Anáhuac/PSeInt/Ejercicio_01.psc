// Descripción: Leer tres números y calcular su suma, producto y promedio.
Algoritmo Ejercicio_01
	Definir numero1, numero2, numero3 Como Real
	Definir suma, producto, promedio Como Real
	Escribir 'Ingresa el primer número:'
	Leer numero1
	Escribir 'Ingresa el segundo número:'
	Leer numero2
	Escribir 'Ingresa el tercer número:'
	Leer numero3
	suma <- numero1+numero2+numero3
	producto <- numero1*numero2*numero3
	promedio <- suma/3
	Escribir 'La suma de los tres números es: ', suma
	Escribir 'El producto de los tres números es: ', producto
	Escribir 'El promedio de los tres números es: ', promedio
FinAlgoritmo
