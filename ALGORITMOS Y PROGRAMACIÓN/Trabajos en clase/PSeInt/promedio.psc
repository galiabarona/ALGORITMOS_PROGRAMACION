Algoritmo promedio
	Definir c1, c2, c3, c4, s Como Entero
	Definir p Como Real
	// Lectura de valores
	Escribir 'Ingrese la calificación 1' // Inicio
	Leer c1
	Escribir ''
	Escribir 'Ingrese la calificacion 2'
	Leer c2
	Escribir ''
	Escribir 'Ingrese la calificacion 3'
	Leer c3
	Escribir ''
	Escribir 'Ingrese la calificacion 4'
	Leer c4
	// Proceso
	s <- c1+c2+c3+c4
	p <- s/4
	// Mostrar P en pantalla
	Escribir 'El promedio es: ', p
FinAlgoritmo
