Algoritmo Promedio
	Definir cal1,cal2,cal3 como Entero
	Definir Prom Como Real
	Escribir "Escribe la calificacion 1"
	Leer Cal1
	Escribir "Escribe la calificacion 2"
	Leer Cal2
	Escribir "Escribe la calificacion 3"
	Leer Cal3
	Prom = (cal1+cal2+cal3)/3.0
	Si prom>=60 Entonces
		Escribir "Promedio: ",prom, ",Estudiante Aprobado"
	SiNo
		Escribir "Promedio: ",prom,",Estudiante Reprobado"
	FinSi
FinAlgoritmo
