// Galia Barona Bustamante 
// Suma de los números pares comprendidos entre 2 y 100. 
Algoritmo P1A10_04_BustamanetBaronaGalia
	
	Definir suma, num Como Entero
	suma <- 2
	num <- 4
	
	Mientras num <= 100
		suma <- suma + num
		num <- num + 2
	FinMientras
	
	Escribir "Suma es: ", suma
	
FinAlgoritmo
