// Galia Barona Bustamante
// Calcular la suma de los cincuenta primeros números enteros.
Algoritmo P1A10_08_BustamanteBaronaGalia
	Definir suma, num Como Entero
	suma <- 0
	num <- 1
	Mientras num<=50 Hacer
		suma <- suma+num
		num <- num+1
	FinMientras
	Escribir 'La suma de los primeros 50 numeros enteros es: ', suma
FinAlgoritmo
